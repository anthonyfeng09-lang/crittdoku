# Cloud accounts (optional). Copy this file to .env.local and fill in the two
# values from your Supabase project: Settings -> API.
#
# The anon key is a PUBLIC key - it is safe to ship in a frontend build.
# Access is guarded by row-level security (see SUPABASE.md for the SQL).
#
# Leave .env.local absent and the game still runs, profile saved locally only.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
